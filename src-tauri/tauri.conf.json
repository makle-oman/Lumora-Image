{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lumora image",
  "version": "1.0.9",
  "identifier": "com.lumora.image-studio",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/lumora-server"],
    "resources": {
      "../dist/": "web/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
