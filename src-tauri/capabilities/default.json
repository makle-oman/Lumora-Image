{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Lumora desktop window permissions",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:8787/*"]
  },
  "permissions": [
    "core:default",
    "allow-desktop-settings",
    "dialog:allow-open",
    "process:allow-restart"
  ]
}
